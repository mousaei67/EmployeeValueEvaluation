@{
    ViewData["Title"] = "سامانه ارزندگی نیروی برنامه‌نویس";
}

<div class="p-4 bg-white rounded shadow-sm">
    <h1 class="h3">سامانه ارزیابی ارزندگی نیروی برنامه‌نویس</h1>
    <p class="text-muted">
        این سامانه برای هر نفر محاسبه می‌کند: چقدر ارزش اقتصادی ساخته، کیفیت کارش چقدر بوده،
        چقدر ریسک ایجاد کرده، حقوقش نسبت به ارزشش منطقی است یا نه، کجا مشکل دارد و کجا باید بیشتر مدیریت شود.
    </p>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-controller="Evaluation" asp-action="Index">مشاهده داشبورد ارزندگی</a>
        <a class="btn btn-outline-secondary" asp-controller="Tasks" asp-action="Create">ثبت کار جدید</a>
        <a class="btn btn-outline-secondary" asp-controller="Employees" asp-action="Index">مدیریت پرسنل</a>
    </div>
</div>
